from collections import deque

def solve():
    # State = (Missionaries_left, Cannibals_left, Boat_position)
    # Boat position: 0 = Left, 1 = Right

    start = (3, 3, 0)
    goal = (0, 0, 1)

    queue = deque([(start, [])])
    visited = {start}

    moves = [
        (1, 0), (2, 0),
        (0, 1), (0, 2),
        (1, 1)
    ]

    def valid(m, c):
        if m < 0 or c < 0 or m > 3 or c > 3:
            return False

        # Left bank
        if m > 0 and m < c:
            return False

        # Right bank
        mr = 3 - m
        cr = 3 - c

        if mr > 0 and mr < cr:
            return False

        return True

    while queue:
        state, path = queue.popleft()

        if state == goal:
            print("Solution:")
            for s in path + [state]:
                print(s)
            return

        m, c, boat = state

        for dm, dc in moves:
            if boat == 0:
                new_state = (m - dm, c - dc, 1)
            else:
                new_state = (m + dm, c + dc, 0)

            if valid(new_state[0], new_state[1]) and new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + [state]))

solve()
