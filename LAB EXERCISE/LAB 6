from collections import deque

def vacuum_cleaner():
    # State = (Vacuum_position, Room_A, Room_B)
    # 0 = Dirty, 1 = Clean

    start = (0, 0, 0)

    queue = deque([(start, [])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        position, A, B = state

        # Goal: both rooms are clean
        if A == 1 and B == 1:
            print("Solution:")
            for action in path:
                print(action)
            return

        # Suck dirt
        if position == 0 and A == 0:
            new_state = (0, 1, B)
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + ["Clean Room A"]))

        elif position == 1 and B == 0:
            new_state = (1, A, 1)
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + ["Clean Room B"]))

        # Move right
        if position == 0:
            new_state = (1, A, B)
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + ["Move Right"]))

        # Move left
        elif position == 1:
            new_state = (0, A, B)
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + ["Move Left"]))

vacuum_cleaner()
