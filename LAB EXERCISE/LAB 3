from collections import deque

def water_jug():
    capacity1 = 4
    capacity2 = 3
    target = 2

    queue = deque()
    queue.append((0, 0))

    visited = set()
    visited.add((0, 0))

    parent = {}

    while queue:
        x, y = queue.popleft()

        if x == target or y == target:
            path = []
            state = (x, y)

            while state != (0, 0):
                path.append(state)
                state = parent[state]

            path.append((0, 0))
            path.reverse()

            print("Solution:")
            for state in path:
                print(state)
            return

        next_states = [
            (capacity1, y),                         # Fill jug 1
            (x, capacity2),                         # Fill jug 2
            (0, y),                                 # Empty jug 1
            (x, 0),                                 # Empty jug 2
            (x - min(x, capacity2 - y),
             y + min(x, capacity2 - y)),            # Pour 1 -> 2
            (x + min(y, capacity1 - x),
             y - min(y, capacity1 - x))             # Pour 2 -> 1
        ]

        for new_state in next_states:
            if new_state not in visited:
                visited.add(new_state)
                parent[new_state] = (x, y)
                queue.append(new_state)

water_jug()
